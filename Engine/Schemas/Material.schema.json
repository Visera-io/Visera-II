{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "visera://schemas/Material.schema.json",
  "title": "Visera Material",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "Shader", "Surface", "Textures"],
  "properties": {
    "Version": {
      "type": "integer",
      "minimum": 1,
      "description": "Visera material asset format version."
    },
    "Name": {
      "type": "string",
      "description": "Optional display name."
    },
    "Shader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Vert", "Frag"],
      "description": "Vertex and fragment shader .vshader assets.",
      "properties": {
        "Vert": {
          "type": "string",
          "minLength": 1,
          "description": "Vertex shader .vshader filename (e.g. Sprite.VertMain.vshader)."
        },
        "Frag": {
          "type": "string",
          "minLength": 1,
          "description": "Fragment shader .vshader filename (e.g. Sprite.FragMain.vshader)."
        }
      }
    },
    "Surface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["Type"],
          "description": "Surface type (blend mode).",
          "properties": {
            "Type": {
              "type": "string",
              "enum": ["Opaque", "Masked", "Transparent"],
              "description": "High-level surface type."
            }
          }
        },
        {
          "type": "string",
          "enum": ["Opaque", "Masked", "Transparent"],
          "description": "Legacy: Surface type only."
        }
      ],
      "description": "Surface type. Use object { Type } or legacy string."
    },
    "Textures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BaseColor"],
      "description": "Texture bindings by semantic name. Paths/ids resolved by AssetHub (VFS).",
      "properties": {
        "BaseColor": {
          "type": "string",
          "minLength": 1,
          "description": "Base color texture asset path/id."
        }
      }
    }
  }
}
