{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "visera://schemas/Material.schema.json",
  "title": "Visera Material",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "Shader"],
  "properties": {
    "Version": {
      "type": "integer",
      "enum": [1],
      "description": "Visera material asset format version (1)."
    },
    "Name": {
      "type": "string",
      "description": "Optional display name."
    },
    "Shader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Vert", "Frag"],
      "description": "Vertex and fragment shader .vshader assets.",
      "properties": {
        "Vert": {
          "type": "string",
          "minLength": 1,
          "description": "Vertex shader .vshader path (e.g. ../Shader/Sprite.VertMain.vshader)."
        },
        "Frag": {
          "type": "string",
          "minLength": 1,
          "description": "Fragment shader .vshader path (e.g. ../Shader/Sprite.FragMain.vshader)."
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pipeline state: surface type, cull mode, depth write.",
      "properties": {
        "Surface": {
          "type": "string",
          "enum": ["Opaque", "Masked", "Transparent"],
          "default": "Opaque",
          "description": "Surface / blend mode."
        },
        "CullMode": {
          "type": "string",
          "enum": ["None", "Front", "Back", "TwoSided"],
          "default": "Back",
          "description": "Rasterization cull mode."
        },
        "ZWrite": {
          "type": "boolean",
          "default": true,
          "description": "Enable depth write."
        }
      }
    },
    "Textures": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Image asset path for this texture binding."
      },
      "description": "Texture name (from shader reflection) -> image path."
    },
    "Samplers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Filter": {
            "type": "string",
            "enum": ["Linear", "Nearest"],
            "default": "Linear",
            "description": "Sampler filter."
          },
          "AddressMode": {
            "type": "string",
            "enum": ["Repeat", "MirroredRepeat", "Clamp", "ClampToBorder", "MirrorClampToEdge"],
            "default": "Repeat",
            "description": "Sampler address mode (Clamp = ClampToEdge)."
          }
        }
      },
      "description": "Sampler name (from reflection) -> { Filter, AddressMode }."
    }
  }
}
